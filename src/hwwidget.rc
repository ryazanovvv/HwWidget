// Resources: the manifest, the icon, the PawnIO module for AMD CPUs and the version.
1 24 "app.manifest"
1 ICON "app.ico"
101 RCDATA "pawnio/AMDFamily17.bin" // IDR_PAWNIO_AMD in widget.h

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "HW Widget"
            VALUE "FileVersion", "2.0.0"
            VALUE "InternalName", "HwWidget"
            VALUE "OriginalFilename", "HwWidget.exe"
            VALUE "ProductName", "HW Widget"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
